{
	"name": "@maxwhitten/opentui-svelte",
	"version": "0.2.0-dev.0",
	"description": "Svelte 5 terminal renderer for OpenTUI",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/MaxWhitten/opentui-svelte.git"
	},
	"exports": {
		".": "./src/index.ts",
		"./dom": "./src/dom.ts",
		"./keyboard": "./src/keyboard.ts",
		"./preload": "./src/preload.ts",
		"./bun-plugin": "./src/svelte-plugin.ts",
		"./elements": "./src/elements.d.ts"
	},
	"files": [
		"src",
		"README.md",
		"UPSTREAM.md",
		"PARITY.md"
	],
	"engines": {
		"bun": ">=1.3.14"
	},
	"peerDependencies": {
		"@opentui/core": "0.9.2",
		"svelte": "5.57.3"
	},
	"devDependencies": {
		"@opentui/core": "0.9.2",
		"svelte": "5.57.3",
		"@types/bun": "1.4.4",
		"typescript": "7.0.2"
	},
	"scripts": {
		"test": "bun --conditions=browser test --preload ./src/preload.ts ./tests",
		"typecheck": "tsc --noEmit",
		"build": "bun scripts/build.ts"
	}
}
